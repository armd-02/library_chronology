{
    "eventDateFilter": {
        "use": false,
        "category": "",
        "label": "イベント日付",
        "allLabel": "全ての催し物",
        "dateField": "event_dates",
        "dates": [],
        "activityDates": {}
    },
    "stampMarkers": {
        "use": false,
        "osmIds": [],
        "ringColor": "#D65C8C"
    },
    "documentPreview": {
        "use": false,
        "field": "document_preview"
    },
    "mapImageLinks": {
        "use": false,
        "minZoom": 13,
        "maxZoom": 19,
        "items": []
    },
    "siteUpdates": {
        "use": false
    },
    "mapDisplayStatus": {
        "use": false
    },
    "map": {
        "changeMap": true,
        "tileName": "OSMFJ_NOPOI_DARK",
        "viewCenter": [
            137.157,
            37.169
        ],
        "viewPitch": 0,
        "maxPitch": 60,
        "maxBounds": null,
        "initZoom": 5.5,
        "maxZoom": 12,
        "detailZoom": 5,
        "zoomMessageThreshold": 5,
        "textFont": [
            "Noto Sans Bold"
        ],
        "textSize": 12,
        "polygonMarker": {
            "fill-color": "#CC6666",
            "fill-opacity": 0.3
        },
        "minZoom": 5
    },
    "mapIllustrations": {
        "use": false,
        "autoHide": false,
        "referenceZoom": 15,
        "minZoom": 0,
        "maxZoom": 24,
        "widthPx": 120,
        "mobileWidthPx": 80,
        "shadow": {
            "use": true,
            "color": "rgba(0, 0, 0, 0.25)",
            "blurPx": 4,
            "offsetXPx": 2,
            "offsetYPx": 4
        },
        "maxVisible": {
            "desktop": 4,
            "mobile": 2
        },
        "avoidPaddingPx": 24,
        "illustrationGapPx": 40,
        "items": []
    },
    "minimap": {
        "use": false,
        "height": 200,
        "initZoom": 2,
        "viewCenter": [
            135,
            34
        ]
    },
    "icon": {
        "photoMarkers": {
            "use": false,
            "maxMarkers": 100,
            "imageFields": []
        },
        "fgPath": "icon",
        "bgPath": "image",
        "flagPath": "./flags/w40",
        "shadow": 0.7,
        "attention": 0.8,
        "green": 0.6,
        "middle": 0.6,
        "visited": 0.4,
        "normal": 0.6,
        "flag": 0.5,
        "textFont": [
            "Noto Sans Regular"
        ],
        "textSize": 12,
        "textViewZoom": 11,
        "markerColors": {
            "hover": {
                "stroke": "#e9a05b"
            },
            "attention": {
                "fill": "#ffffff",
                "stroke": "#888888"
            },
            "green": {
                "fill": "#ffffff",
                "stroke": "#51b3a1"
            },
            "middle": {
                "fill": "#ffffff",
                "stroke": "#4d77ac"
            },
            "normal": {
                "fill": "#ffffff",
                "stroke": "#bfbfe1"
            },
            "visited": {
                "fill": "#ffffff",
                "stroke": "#9c9c9c"
            }
        }
    },
    "poiView": {
        "openingHours": false,
        "poiActLoad": true,
        "poiZoom": {
            "activity": 5,
            "library": 10
        },
        "mobilePoiZoom": {},
        "editZoom": {},
        "poiFilter": "all"
    },
    "poiData": {
        "maxFeatures": 12000,
        "pruneThreshold": 15000,
        "applyToStatic": false
    },
    "selectItem": {
        "default": "",
        "menu": "",
        "action": "ChangePoi"
    },
    "sideBar": {
        "everyView": true,
        "initView": "view"
    },
    "listTable": {
        "nameFallback": "category",
        "backgroundImage": "./image/library-chronology-background.png",
        "category": "activity",
        "target": "activity",
        "allActs": true,
        "playback": {
            "view": true,
            "zoomLevel": 11,
            "timer": 4000
        },
        "download": false,
        "csvColumn": [
            "id",
            "categoryJa",
            "name",
            "parentName",
            "tag",
            "categoryData",
            "iconFile",
            "lng",
            "lat"
        ],
        "height": 0.6,
        "includeUnmapped": true
    },
    "feature3d": {
        "use": false
    },
    "thumbnail": {
        "backend": {
            "use": false,
            "url": "",
            "concurrency": 2
        },
        "use": false,
        "limits": 20,
        "slideThumbWidth": "320",
        "modalThumbWidth": "800"
    },
    "static": {
        "use": true,
        "osmjsons": [
            "./data/japan_library.json"
        ]
    },
    "indoor": {
        "use": false
    },
    "wikipedia": {
        "marker": "wikipedia.svg",
        "api_": "wikipedia.org/w/api.php?format=json&action=query&prop=extracts%7Cimages&exintro=&explaintext=&titles=",
        "api": "wikipedia.org/api/rest_v1/page/summary/",
        "domain": "wikipedia.org",
        "tag": "wikipedia",
        "image": true
    },
    "etc": {
        "relativePath": "",
        "showPersonalMemo": false,
        "showVisited": false,
        "editModeSwitch": false,
        "localSave": "library-chronology",
        "reverseIcon": false,
        "editMode": false,
        "splashUrl": "./image/library-chronology-cover.png",
        "loadingUrl": "./image/loading.gif"
    },
    "menu": {
        "main": [
            {
                "glot-model": "licence_title",
                "linkto": "javascript:cMapMaker.licence()",
                "divider": false
            },
            {
                "glot-model": "about",
                "linkto": "https://github.com/armd-02/library_chronology",
                "divider": false
            },
            {
                "glot-model": "library-redesign",
                "linkto": "https://library-redesign.main.jp/",
                "divider": true
            },
            {
                "glot-model": "owner",
                "linkto": "https://github.com/K-Sakanoshita/community_mapmaker",
                "divider": false
            },
            {
                "glot-model": "openstreetmap",
                "linkto": "https://www.openstreetmap.org/about",
                "divider": false
            }
        ],
        "mainSystem": [],
        "modal": [
            {
                "glot-model": "copyShareLink",
                "linkto": "javascript:cMapMaker.shareURL()",
                "divider": false
            },
            {
                "glot-model": "osm_open",
                "linkto": "javascript:winCont.osm_open(cMapMaker.openOSMid)",
                "divider": false
            }
        ],
        "activities": [],
        "editActivity": [
            {
                "btn_class": "btn btn-light btn-lg border-secondary w-50 m-2 p-1",
                "code": "javascript:modalActs.save()",
                "icon_class": "fa-solid fa-cloud-arrow-up",
                "btn_glot_name": "act_save"
            }
        ],
        "visited": [
            {
                "btn_class": "btn btn-light border-secondary pe-auto",
                "code": "javascript:poiStatusCont.import_load()",
                "icon_class": "fa-solid fa-cloud-arrow-up",
                "btn_glot_name": "act_upload"
            }
        ]
    },
    "activity": {
        "url": "https://armd-01.sakura.ne.jp/community-mapmaker-backend/api/activities.php?app=library_chronology",
        "targetName": "activity",
        "authMode": "basic",
        "chronology": true,
        "actTitle": "title"
    },
    "news": {
        "use": false
    },
    "changes": {
        "use": false
    },
    "intro": {
        "use": false
    },
    "areaFeatureLinker": {
